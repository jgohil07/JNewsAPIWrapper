{
 "_comment": "Keyword rules that add topics (by: rule). Patterns are case-insensitive Java regexes joined with OR; a rule applies only to items in its appliesTo categories. Feed-section topics (by: feed) come from sources.json.",
 "rules": [
  {
   "topic": "markets",
   "label": "Markets",
   "appliesTo": [
    "india-markets",
    "india-business",
    "economy",
    "business",
    "india"
   ],
   "patterns": [
    "\\bSensex\\b",
    "\\bNifty(?:\\s?50|\\s?Bank)?\\b",
    "\\bstock markets?\\b",
    "(?-i:\\bFIIs?\\b)",
    "(?-i:\\bFPIs?\\b)",
    "(?-i:\\bDIIs?\\b)",
    "\\bDalal Street\\b"
   ]
  },
  {
   "topic": "stocks",
   "label": "Stocks",
   "appliesTo": [
    "india-markets",
    "india-business",
    "economy",
    "business",
    "india"
   ],
   "patterns": [
    "\\bshares? (?:rose|fell|jumped|surged|slumped|tanked|gained|declined|rallied)\\b",
    "\\bstocks? to (?:buy|watch)\\b",
    "\\btarget price\\b",
    "\\b52-week (?:high|low)\\b",
    "\\bupper circuit\\b",
    "\\blower circuit\\b"
   ]
  },
  {
   "topic": "ipo",
   "label": "IPOs",
   "appliesTo": [
    "india-markets",
    "india-business",
    "economy",
    "business",
    "india"
   ],
   "patterns": [
    "(?-i:\\bIPOs?\\b)",
    "(?-i:\\bDRHP\\b)",
    "\\bgrey market premium\\b",
    "(?-i:\\bGMP\\b)",
    "\\blisting gains?\\b",
    "\\banchor investors?\\b",
    "\\bpublic issue\\b"
   ]
  },
  {
   "topic": "earnings",
   "label": "Earnings",
   "appliesTo": [
    "india-markets",
    "india-business",
    "economy",
    "business",
    "india"
   ],
   "patterns": [
    "\\bQ[1-4]\\s?(?:FY\\s?\\d{2,4}\\s)?(?:results?|earnings|profit|net profit)\\b",
    "\\bquarterly (?:results?|earnings)\\b",
    "\\bnet profit\\b",
    "(?-i:\\bPAT\\b)",
    "(?-i:\\bEBITDA\\b)",
    "\\bearnings (?:beat|miss)\\b"
   ]
  },
  {
   "topic": "rbi",
   "label": "RBI",
   "appliesTo": [
    "india-markets",
    "india-business",
    "economy",
    "business",
    "india"
   ],
   "patterns": [
    "(?-i:\\bRBI\\b)",
    "\\bReserve Bank of India\\b",
    "\\brepo rate\\b",
    "\\bmonetary policy committee\\b",
    "(?-i:\\bMPC\\b)"
   ]
  },
  {
   "topic": "sebi",
   "label": "SEBI",
   "appliesTo": [
    "india-markets",
    "india-business",
    "economy",
    "business",
    "india"
   ],
   "patterns": [
    "(?-i:\\bSEBI\\b)",
    "\\bSecurities and Exchange Board of India\\b"
   ]
  },
  {
   "topic": "commodities",
   "label": "Commodities",
   "appliesTo": [
    "india-markets",
    "india-business",
    "economy",
    "business",
    "india"
   ],
   "patterns": [
    "\\bgold (?:price|prices|rate|rates)\\b",
    "\\bsilver (?:price|prices|rate|rates)\\b",
